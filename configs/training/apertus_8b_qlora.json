{
  "schema_version": "1.0",
  "stage": "sft",
  "model": {
    "model_id": "swiss-ai/Apertus-8B-Instruct-2509",
    "revision": "b946d40447b2b597999b9c86d44bee0b452c919f",
    "reported_license": "apache-2.0",
    "trust_remote_code": false
  },
  "dataset": {
    "train_path": "data/processed/sft_train.jsonl",
    "eval_path": "data/processed/sft_validation.jsonl",
    "minimum_accepted_train_records": 3000,
    "messages_field": "messages"
  },
  "quantization": {
    "load_in_4bit": true,
    "bnb_4bit_quant_type": "nf4",
    "bnb_4bit_use_double_quant": true,
    "bnb_4bit_compute_dtype": "bfloat16"
  },
  "lora": {
    "r": 64,
    "lora_alpha": 128,
    "lora_dropout": 0.05,
    "bias": "none",
    "task_type": "CAUSAL_LM",
    "target_modules": "all-linear"
  },
  "training": {
    "output_dir": "artifacts/apertus-8b-biblical-moral-sft",
    "max_length": 4096,
    "num_train_epochs": 3,
    "per_device_train_batch_size": 1,
    "per_device_eval_batch_size": 1,
    "gradient_accumulation_steps": 16,
    "gradient_checkpointing": true,
    "learning_rate": 0.0001,
    "lr_scheduler_type": "cosine",
    "warmup_ratio": 0.05,
    "optim": "paged_adamw_8bit",
    "bf16": true,
    "logging_steps": 5,
    "eval_strategy": "steps",
    "eval_steps": 100,
    "save_steps": 100,
    "save_total_limit": 3,
    "seed": 20260811,
    "report_to": "none"
  },
  "gates": {
    "project_preflight_required": true,
    "cuda_required": true,
    "minimum_gpu_vram_gib": 24,
    "smoke_test_required_before_full_run": true,
    "resume_requires_manifest_match": true
  }
}

