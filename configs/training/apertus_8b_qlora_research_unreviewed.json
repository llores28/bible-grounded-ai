    "learning_rate": 0.0001,
    "lr_scheduler_type": "cosine",
    "warmup_ratio": 0.05,
    "optim": "paged_adamw_8bit",
    "bf16": true,
    "logging_steps": 1,
    "eval_strategy": "no",
    "save_strategy": "no",
    "seed": 20260811,
    "report_to": "none"
