{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bible-grounded-ai.local/schemas/sft-example.schema.json",
  "title": "ReviewedSFTExample",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_id", "scenario_id", "category", "status", "high_impact", "answer", "provenance", "reviews"],
  "properties": {
    "record_id": {"type": "string", "pattern": "^SFT-[A-Z0-9_-]+$"},
    "scenario_id": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "status": {"const": "accepted"},
    "high_impact": {"type": "boolean"},
    "answer": {"$ref": "moral-answer.schema.json"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author_id", "created_at", "source_ids", "license_check_ids"],
      "properties": {
        "author_id": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date-time"},
        "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "license_check_ids": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}}
      }
    },
    "reviews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reviewer_id", "decision", "rationale", "reviewed_at", "affiliations_disclosed", "independent"],
        "properties": {
          "reviewer_id": {"type": "string", "minLength": 1},
          "decision": {"const": "approve"},
          "rationale": {"type": "string", "minLength": 1},
          "reviewed_at": {"type": "string", "format": "date-time"},
          "affiliations_disclosed": {"type": "boolean"},
          "independent": {"const": true}
        }
      }
    },
    "adjudication": {"type": ["object", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"high_impact": {"const": true}}, "required": ["high_impact"]},
      "then": {"properties": {"reviews": {"minItems": 2}}}
    }
  ]
}

