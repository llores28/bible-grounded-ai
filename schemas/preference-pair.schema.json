{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bible-grounded-ai.local/schemas/preference-pair.schema.json",
  "title": "ReviewedPreferencePair",
  "type": "object",
  "additionalProperties": false,
  "required": ["pair_id", "scenario_id", "status", "high_impact", "prompt", "chosen", "rejected", "preference_reasons", "provenance", "reviews"],
  "properties": {
    "pair_id": {"type": "string", "pattern": "^DPO-[A-Z0-9_-]+$"},
    "scenario_id": {"type": "string", "minLength": 1},
    "status": {"const": "accepted"},
    "high_impact": {"type": "boolean"},
    "prompt": {"type": "string", "minLength": 1},
    "chosen": {"$ref": "moral-answer.schema.json"},
    "rejected": {"$ref": "moral-answer.schema.json"},
    "preference_reasons": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author_id", "created_at", "source_ids", "license_check_id"],
      "properties": {
        "author_id": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date-time"},
        "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "license_check_id": {"type": "string", "minLength": 1}
      }
    },
    "reviews": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["reviewer_id", "decision", "rationale", "independent", "affiliations_disclosed"],
        "properties": {
          "reviewer_id": {"type": "string", "minLength": 1},
          "decision": {"const": "approve_chosen"},
          "rationale": {"type": "string", "minLength": 1},
          "independent": {"const": true},
          "affiliations_disclosed": {"const": true}
        }
      }
    }
  }
}
