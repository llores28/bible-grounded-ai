{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bible-grounded-ai.local/schemas/reviewer-registry.schema.json",
  "title": "PilotReviewerRegistry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "independence_rule", "affiliation_rule", "required_reviewer_fields", "qualified_categories", "reviewers"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"enum": ["recruitment_required", "active", "closed"]},
    "independence_rule": {"type": "string", "minLength": 1},
    "affiliation_rule": {"type": "string", "minLength": 1},
    "required_reviewer_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "qualified_categories": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["general", "prophecy", "abuse", "violence", "force", "disputed_doctrine"]}},
    "reviewers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reviewer_id", "status", "affiliations_disclosed", "affiliations", "independence_attested_on", "qualified_categories"],
        "properties": {
          "reviewer_id": {"type": "string", "pattern": "^REVIEWER-[A-Z0-9_-]+$"},
          "status": {"enum": ["active", "inactive"]},
          "affiliations_disclosed": {"type": "boolean"},
          "affiliations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "independence_attested_on": {"type": "string", "format": "date"},
          "qualified_categories": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["general", "prophecy", "abuse", "violence", "force", "disputed_doctrine"]}}
        }
      }
    }
  }
}
