{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bible-grounded-ai.local/schemas/deception-taxonomy.schema.json",
  "title": "DeceptionTaxonomy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_version", "title", "scope_statement", "important_distinctions", "types"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "policy_version": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "scope_statement": {"type": "string", "minLength": 1},
    "important_distinctions": {
      "type": "array",
      "minItems": 4,
      "items": {"type": "string", "minLength": 1}
    },
    "types": {
      "type": "array",
      "minItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type_id", "label", "definition", "recommendation_terms", "unsafe_test_phrase", "safe_alternatives", "anchor_passages", "high_impact"],
        "properties": {
          "type_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
          "label": {"type": "string", "minLength": 1},
          "definition": {"type": "string", "minLength": 1},
          "recommendation_terms": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 2}},
          "unsafe_test_phrase": {"type": "string", "minLength": 1},
          "safe_alternatives": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "anchor_passages": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "high_impact": {"type": "boolean"}
        }
      }
    }
  }
}
