{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bible-grounded-ai.local/schemas/pilot-eval.schema.json",
  "title": "ReviewedPilotEvaluation",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "scenario_id", "category", "status", "high_impact", "expected_decision", "answer", "provenance", "reviews"],
  "properties": {
    "case_id": {"type": "string", "pattern": "^EVAL-[A-Z0-9_-]+$"},
    "scenario_id": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "status": {"const": "accepted"},
    "high_impact": {"type": "boolean"},
    "expected_decision": {"enum": ["release", "refuse", "escalate"]},
    "answer": {"$ref": "moral-answer.schema.json"},
    "provenance": {
      "type": "object",
      "required": ["author_id", "created_at", "source_ids", "license_check_ids"],
      "properties": {
        "author_id": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date-time"},
        "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "license_check_ids": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}}
      }
    },
    "reviews": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "adjudication": {"type": ["object", "null"]}
  }
}
