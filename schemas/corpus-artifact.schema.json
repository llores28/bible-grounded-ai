{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bible-grounded-ai.local/schemas/corpus-artifact.schema.json",
  "title": "ApprovedCorpusArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_id", "revision", "passages"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "source_id": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "minLength": 1},
    "passages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reference", "book", "chapter", "verse_start", "language", "text"],
        "properties": {
          "reference": {"type": "string", "minLength": 1},
          "book": {"type": "string", "minLength": 1, "description": "Canonical name or configured alias from configs/canon.json"},
          "chapter": {"type": "integer", "minimum": 1},
          "verse_start": {"type": "integer", "minimum": 1},
          "verse_end": {"type": "integer", "minimum": 1},
          "language": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "context": {"type": "string"}
        }
      }
    }
  }
}
